# Required for npm run build and npm run check. Use your Vercel project URL until a domain is chosen.
SITE_URL=
# Secret from Banxico SIE; build-time only, never used by browser code.
BANXICO_TOKEN=
# Secret generated by Vercel for the daily Cron function.
CRON_SECRET=
# Production-branch Vercel Deploy Hook URL; do not expose it to clients.
VERCEL_DEPLOY_HOOK=
