{
  "name": "calculadoras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-country everyday and business calculators. First product: Mexico payroll-payout suite (LFT + LISR).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node --env-file-if-exists=.env scripts/fetch-udis.mjs",
    "build": "astro build && node scripts/postbuild.mjs",
    "build:lab": "LAB=1 astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docker": "node scripts/playwright-docker.mjs",
    "lhci": "lhci autorun",
    "budget": "node scripts/js-budget.mjs",
    "params:report": "node scripts/params-report.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "node scripts/check.mjs",
    "lh:summary": "node scripts/lh-summary.mjs",
    "fonts:subset": "python3 scripts/subset-fonts.py",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.6",
    "astro": "7.3.8",
    "motion": "14.1.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/bitter": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "satori": "0.52.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
