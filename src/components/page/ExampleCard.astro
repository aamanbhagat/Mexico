---
/**
 * A worked example: the story, the key inputs and the engine's results computed at build time.
 * The same example objects are asserted in the golden tests, so what is shown is what is tested.
 */
import type { LocaleCode } from '../../i18n/locales';
import { siteUi } from '../../i18n/ui';

interface Props {
  title: string;
  story: string;
  rows: { label: string; value: string }[];
  source: { label: string; url: string };
  href?: string;
  locale?: LocaleCode | undefined;
}
const { title, story, rows, source, href, locale = 'es-mx' } = Astro.props;
const ui = siteUi(locale);
---

<article class="example">
  <h3>{title}</h3>
  <p>{story}</p>
  <dl>
    {
      rows.map((r) => (
        <div>
          <dt>{r.label}</dt>
          <dd>{r.value}</dd>
        </div>
      ))
    }
  </dl>
  <p class="example__source">
    {ui.exampleSource}
    <a href={source.url} rel="noopener" target="_blank">{source.label}</a>
    {
      href && (
        <>
          {' · '}
          <a href={href}>{ui.openExample}</a>
        </>
      )
    }
  </p>
</article>
