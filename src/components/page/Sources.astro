---
import { PARAM_FILES, type ParamId } from '../../lib/params/registry';
import { formatDateLong } from '../../lib/ui/format';
import { getLocale, type LocaleCode } from '../../i18n/locales';
import { siteUi } from '../../i18n/ui';

export interface ExtraSource {
  title: string;
  url: string;
  note?: string | undefined;
}

/** A source prepared by the page (e.g. from a land-unit catalog): title, link, one meta line, verification state. */
export interface SourceItem {
  title: string;
  url: string;
  meta: string;
  /** undefined = not a registry value (no verification label). */
  verified?: boolean | undefined;
}

interface Props {
  /** Registry parameters used on this page (any country); the version in force on `asOf` is cited. */
  params?: ParamId[] | undefined;
  asOf?: string | undefined;
  /** Sources prepared by the page, listed after the registry parameters. */
  items?: SourceItem[] | undefined;
  extra?: ExtraSource[] | undefined;
  locale?: LocaleCode | undefined;
}
const { params = [], asOf = '', items = [], extra = [], locale = 'es-mx' } = Astro.props;
const ui = siteUi(locale);
const intl = getLocale(locale).intl;

const cited = params.map((id) => {
  const file = PARAM_FILES[id];
  const version = [...file.versions].reverse().find((v) => v.effective_from <= asOf) ?? file.versions[file.versions.length - 1];
  return { file, version: version! };
});
---

<ul class="sources">
  {
    cited.map(({ file, version }) => (
      <li>
        <a href={version.source_url} rel="noopener" target="_blank">
          {version.source_title}
        </a>
        <span class="sources__meta">
          {file.name} · {ui.sourceMeta.effectiveFrom} {formatDateLong(version.effective_from, intl)} · {ui.sourceMeta.retrievedOn}{' '}
          {formatDateLong(version.retrieved_on, intl)} ·{' '}
          {version.verified ? (
            <span class="verify verify--ok">{ui.sourceMeta.verified}</span>
          ) : (
            <span class="verify verify--pending">{ui.sourceMeta.pending}</span>
          )}
        </span>
      </li>
    ))
  }
  {
    items.map((s) => (
      <li>
        <a href={s.url} rel="noopener" target="_blank">
          {s.title}
        </a>
        <span class="sources__meta">
          {s.meta}
          {s.verified !== undefined && (
            <>
              {' · '}
              {s.verified ? (
                <span class="verify verify--ok">{ui.sourceMeta.verified}</span>
              ) : (
                <span class="verify verify--pending">{ui.sourceMeta.pending}</span>
              )}
            </>
          )}
        </span>
      </li>
    ))
  }
  {
    extra.map((s) => (
      <li>
        <a href={s.url} rel="noopener" target="_blank">
          {s.title}
        </a>
        {s.note && <span class="sources__meta">{s.note}</span>}
      </li>
    ))
  }
</ul>
