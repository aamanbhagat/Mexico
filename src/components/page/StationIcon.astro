---
/** Pictogram per calculator, in the spirit of transit wayfinding: one simple shape per tool. */
import type { Pictogram } from '../../i18n/tools';

interface Props {
  /** Pictogram to draw (a tool name or one of the land-unit shapes). */
  tool: Pictogram;
}
const { tool } = Astro.props;
---

<span class="station-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {
      tool === 'aguinaldo' && (
        <>
          <rect x="4" y="9" width="16" height="11" rx="1" />
          <path d="M3 9h18M12 9v11M12 9c-1.5-3-5-4-5-1.5S12 9 12 9Zm0 0c1.5-3 5-4 5-1.5S12 9 12 9Z" />
        </>
      )
    }
    {
      tool === 'finiquito' && (
        <>
          <path d="M6 3h9l4 4v14H6z" />
          <path d="M14 3v5h5M9 13l2 2 4-4" />
        </>
      )
    }
    {
      tool === 'liquidacion' && (
        <>
          <path d="M4 7h16v12H4z" />
          <path d="M9 7V5h6v2M4 12h16" />
        </>
      )
    }
    {
      tool === 'prima-vacacional' && (
        <>
          <circle cx="12" cy="12" r="4" />
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" />
        </>
      )
    }
    {
      tool === 'vacaciones' && (
        <>
          <rect x="4" y="5" width="16" height="15" rx="1" />
          <path d="M4 10h16M9 3v4M15 3v4M9 14h2v2H9z" />
        </>
      )
    }
    {
      tool === 'uma' && (
        <>
          <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
        </>
      )
    }
    {
      tool === 'udis' && (
        <>
          <path d="M3 8h18M3 16h18M7 4v16M17 4v16" />
          <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
        </>
      )
    }
    {
      /* A plot split into four quartas: the alqueire. */
      (tool === 'alqueire' || tool === 'terra') && (
        <>
          <rect x="4" y="4" width="16" height="16" rx="1" />
          <path d="M12 4v16M4 12h16" />
        </>
      )
    }
    {
      /* A square with its 100 m side measured: the hectare. */
      tool === 'hectare' && (
        <>
          <rect x="5" y="8" width="14" height="12" rx="1" />
          <path d="M5 3v3M19 3v3M5 4.5h14" />
        </>
      )
    }
    {
      /* Furrows in a field: the tarefa, a day's work. */
      tool === 'tarefa' && (
        <>
          <rect x="4" y="4" width="16" height="16" rx="1" />
          <path d="M8.5 8v8M12 8v8M15.5 8v8" />
        </>
      )
    }
    {
      /* A one-litre seed measure: the litro de terra. */
      tool === 'litro' && (
        <>
          <path d="M6.5 5h11l-1.6 15H8.1z" />
          <path d="M7.3 10h9.4" />
        </>
      )
    }
    {
      /* weton: two lines (dina, pasaran) crossing at one station */
      tool === 'weton' && (
        <>
          <path d="M3 12h18M12 3v18" />
          <circle cx="12" cy="12" r="3.5" fill="currentColor" />
        </>
      )
    }
    {
      /* jodoh: two weton side by side */
      tool === 'jodoh' && (
        <>
          <circle cx="9" cy="12" r="5" />
          <circle cx="15" cy="12" r="5" />
        </>
      )
    }
    {
      /* kalender Jawa: a month page with the lunar crescent */
      tool === 'kalender' && (
        <>
          <rect x="4" y="5" width="16" height="15" rx="1" />
          <path d="M4 10h16M9 3v4M15 3v4" />
          <path d="M14.5 13.2a3 3 0 1 0 0 4.6 2.4 2.4 0 1 1 0-4.6Z" />
        </>
      )
    }
    {
      /* hari ini: the sun on the horizon (the Javanese day turns at sunset) */
      tool === 'hari-ini' && (
        <>
          <path d="M3 17h18M7 17a5 5 0 0 1 10 0M12 6v3M5.6 9.6l1.8 1.8M18.4 9.6l-1.8 1.8" />
        </>
      )
    }
  </svg>
</span>
