---
import type { LocaleCode } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';
import { SITE } from '../../config/site';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const links = [
  { href: pathFor('mx.aguinaldo', locale), label: 'Aguinaldo' },
  { href: pathFor('mx.finiquito', locale), label: 'Finiquito' },
  { href: pathFor('mx.liquidacion', locale), label: 'Liquidación' },
  { href: pathFor('mx.prima-vacacional', locale), label: 'Prima vacacional' },
  { href: pathFor('mx.vacaciones', locale), label: 'Vacaciones' },
];
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div>
      <h2>{SITE.name}</h2>
      <p>
        Calculadoras con la ley y los valores oficiales vigentes, citados en cada página. Tus datos se procesan en tu navegador: no los
        enviamos a ningún servidor.
      </p>
    </div>
    <div>
      <h2>Calculadoras laborales</h2>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2>Datos oficiales</h2>
      <ul>
        <li><a href={pathFor('mx.uma-salario-minimo', locale)}>UMA y salario mínimo 2026</a></li>
      </ul>
    </div>
  </div>
</footer>
