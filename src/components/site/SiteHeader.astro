---
import type { LocaleCode } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';
import { SITE } from '../../config/site';
import ThemeToggle from './ThemeToggle.astro';
import { siteUi } from '../../i18n/ui';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const home = pathFor('home', locale);
const ui = siteUi(locale);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={home} aria-label={ui.homeAria(SITE.name)}>
      <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>{SITE.name}</span>
    </a>
    <div class="header-actions">
      <nav class="header-nav" aria-label="Principal">
        <a href={home}>{ui.nav}</a>
      </nav>
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
