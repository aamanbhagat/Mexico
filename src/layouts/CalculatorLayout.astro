---
/**
 * Page template for every calculator: answer-first hero, the island, "how we calculate",
 * worked examples, FAQ, sources, last-updated date, disclaimer and the data-driven review badge.
 * Emits WebApplication + FAQPage + BreadcrumbList JSON-LD (CLAUDE.md §6). Strings come from the
 * locale's dictionary (src/i18n/ui.ts); the related links from the tools registry (src/i18n/tools.ts)
 * unless the page passes its own `related`. The Mexico disclaimer is the default; other locales
 * pass theirs through the `disclaimer` slot.
 */
import BaseLayout from './BaseLayout.astro';
import ReviewBadge from '../components/page/ReviewBadge.astro';
import StationIcon from '../components/page/StationIcon.astro';
import Faq from '../components/page/Faq.astro';
import Sources, { type ExtraSource, type SourceItem } from '../components/page/Sources.astro';
import { pathFor, type PageKey } from '../i18n/routes';
import { getLocale, type LocaleCode } from '../i18n/locales';
import { siteUi, type UiLocale } from '../i18n/ui';
import { toolsFor, type Pictogram, type Tool } from '../i18n/tools';
import { breadcrumbLd, datasetLd, faqLd, webAppLd, type Crumb, type FaqItem } from '../lib/seo/jsonld';
import type { ParamId } from '../lib/params/registry';
import type { RelatedLink } from '../components/page/types';
import { formatDateLong } from '../lib/ui/format';

interface Props {
  pageKey: PageKey;
  locale: LocaleCode;
  tool: Tool;
  /** Pictogram in the hero (defaults to the tool's). */
  icon?: Pictogram | undefined;
  /** <title> */
  title: string;
  description: string;
  h1: string;
  /** Short answer under the H1 (the query answered immediately). */
  lede: string;
  /** ISO date shown as "updated on …" and in dateModified. */
  updated: string;
  appName: string;
  faq: FaqItem[];
  /** Registry parameters (any country) cited in the sources section. */
  sourceParams?: ParamId[] | undefined;
  /** Sources prepared by the page (land-unit catalog entries…). */
  sourceItems?: SourceItem[] | undefined;
  extraSources?: ExtraSource[] | undefined;
  /** Date used to pick which parameter version to cite. */
  asOf?: string | undefined;
  direction?: string | undefined;
  noindex?: boolean | undefined;
  pathOverride?: string | undefined;
  /** Hide the examples block when the page has none. */
  hasExamples?: boolean | undefined;
  /** "dataset" for reference pages (no calculator). */
  schema?: 'app' | 'dataset' | undefined;
  /** schema.org applicationCategory for the WebApplication. */
  appCategory?: string | undefined;
  /** Heading of the "how" section. */
  howTitle?: string | undefined;
  /** Breadcrumb trail between home and this page. */
  parents?: Crumb[] | undefined;
  /** Short name of this page in the breadcrumb (defaults to the H1). */
  crumb?: string | undefined;
  /** Related tools; defaults to the locale's tools from src/i18n/tools.ts. */
  related?: RelatedLink[] | undefined;
  /** Key in src/data/reviews.json (defaults to pageKey; a family key such as "id.weton"). */
  reviewKey?: string | undefined;
  /** Generated OG image slug (default: derived from the locale and tool). */
  ogSlug?: string | undefined;
}

const p = Astro.props;
const ui = siteUi(p.locale);
const loc = getLocale(p.locale);
const path = p.pathOverride ?? pathFor(p.pageKey, p.locale);
const home = pathFor('home', p.locale);
const crumbs: Crumb[] = [{ name: ui.home, path: home }, ...(p.parents ?? []), { name: p.crumb ?? p.h1, path }];

const COUNTRY: Record<UiLocale, string> = { 'es-mx': 'México', 'pt-br': 'Brasil', id: 'Indonesia' };
const jsonLd = [
  p.schema === 'dataset'
    ? datasetLd({ name: p.appName, description: p.description, path, dateModified: p.updated })
    : webAppLd({
        name: p.appName,
        description: p.description,
        path,
        inLanguage: loc.hreflang,
        dateModified: p.updated,
        country: COUNTRY[p.locale as UiLocale],
        currency: loc.currency,
        browserRequirements: ui.browserRequirements,
        ...(p.appCategory ? { category: p.appCategory } : {}),
      }),
  faqLd(p.faq),
  breadcrumbLd(crumbs),
];

const related: RelatedLink[] = (
  p.related ?? toolsFor(p.locale as UiLocale).map((r) => ({ href: pathFor(r.key, p.locale), label: r.label, tool: r.tool }))
).filter((r) => r.href !== path);
const reviewKey = p.reviewKey ?? p.pageKey;
// es-MX pages use the tool as slug, pt-BR the land-unit key, the rest "<locale>/<tool>".
const ogSlug = p.ogSlug ?? (p.locale === 'es-mx' ? p.tool : p.pageKey.startsWith('br.') ? p.pageKey.slice(3) : `${p.locale}/${p.tool}`);
const hasDisclaimer = Astro.slots.has('disclaimer');
---

<BaseLayout
  title={p.title}
  description={p.description}
  locale={p.locale}
  pageKey={p.pageKey}
  path={path}
  ogSlug={ogSlug}
  jsonLd={jsonLd}
  tool={p.tool}
  direction={p.direction}
  noindex={p.noindex}
>
  <slot name="head" slot="head" />
  <div class="wrap">
    <nav class="breadcrumbs" aria-label={ui.breadcrumbs}>
      <ol>
        {
          crumbs.slice(0, -1).map((c) => (
            <li>
              <a href={c.path}>{c.name}</a>
            </li>
          ))
        }
        <li aria-current="page">{p.crumb ?? p.h1}</li>
      </ol>
    </nav>

    <header class="hero">
      <div class="hero__title-row">
        <StationIcon tool={p.icon ?? p.tool} />
        <h1>{p.h1}</h1>
      </div>
      <p class="hero__lede">{p.lede}</p>
      <p class="hero__meta">
        <span>{ui.updatedOn} <time datetime={p.updated}>{formatDateLong(p.updated, loc.intl)}</time></span>
        <ReviewBadge pageKey={reviewKey} locale={p.locale} />
      </p>
    </header>

    <slot />

    <section class="section" aria-labelledby="como-se-calcula">
      <h2 id="como-se-calcula">{p.howTitle ?? ui.howTitle}</h2>
      <div class="prose">
        <slot name="how" />
      </div>
    </section>

    {
      p.hasExamples !== false && (
        <section class="section" aria-labelledby="ejemplos">
          <h2 id="ejemplos">{ui.examplesTitle}</h2>
          <slot name="examples" />
        </section>
      )
    }

    <slot name="extra" />

    <section class="section" aria-labelledby="preguntas">
      <h2 id="preguntas">{ui.faqTitle}</h2>
      <Faq items={p.faq} />
    </section>

    <section class="section" aria-labelledby="fuentes">
      <h2 id="fuentes">{ui.sourcesTitle}</h2>
      <slot name="sources-intro" />
      <Sources params={p.sourceParams} asOf={p.asOf} items={p.sourceItems} extra={p.extraSources} locale={p.locale} />
    </section>

    <section class="section" aria-labelledby="aviso">
      <div class="disclaimer">
        <h2 id="aviso">{ui.disclaimerTitle}</h2>
        {
          hasDisclaimer ? (
            <slot name="disclaimer" />
          ) : (
            <>
              <p>
                Este cálculo es una estimación informativa con base en la Ley Federal del Trabajo, la Ley del ISR y los valores oficiales
                vigentes en la fecha indicada. No sustituye asesoría legal ni fiscal: tu contrato, un convenio o una resolución pueden darte
                más. La retención real de ISR depende de la nómina de tu empresa y se ajusta en tu declaración anual.
              </p>
              <p>
                Si tienes un conflicto laboral, la{' '}
                <a href="https://www.gob.mx/profedet" rel="noopener" target="_blank">
                  Procuraduría Federal de la Defensa del Trabajo (PROFEDET)
                </a>{' '}
                te asesora y representa gratis.
              </p>
            </>
          )
        }
        <p><ReviewBadge pageKey={reviewKey} locale={p.locale} /></p>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="section" aria-labelledby="relacionadas">
          <h2 id="relacionadas">{ui.relatedTitle}</h2>
          <ul class="related">
            {related.map((r) => (
              <li>
                <a href={r.href} data-tool={r.tool}>
                  <span class="dot" aria-hidden="true" />
                  {r.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
