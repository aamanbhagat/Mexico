---
/**
 * Page template for every calculator: answer-first hero, the island, "Cómo se calcula",
 * worked examples, FAQ, sources, last-updated date, disclaimer and the data-driven review badge.
 * Emits WebApplication + FAQPage + BreadcrumbList JSON-LD (CLAUDE.md §6).
 */
import BaseLayout from './BaseLayout.astro';
import ReviewBadge from '../components/page/ReviewBadge.astro';
import StationIcon from '../components/page/StationIcon.astro';
import Faq from '../components/page/Faq.astro';
import Sources, { type ExtraSource } from '../components/page/Sources.astro';
import { pathFor, type PageKey } from '../i18n/routes';
import type { LocaleCode } from '../i18n/locales';
import { breadcrumbLd, faqLd, webAppLd, type FaqItem } from '../lib/seo/jsonld';
import type { MxParamId } from '../lib/params/mx';
import { formatDateLong } from '../lib/ui/format';

type Tool = 'aguinaldo' | 'finiquito' | 'liquidacion' | 'prima-vacacional' | 'vacaciones' | 'uma';

interface Props {
  pageKey: PageKey;
  locale: LocaleCode;
  tool: Tool;
  /** <title> */
  title: string;
  description: string;
  h1: string;
  /** Short answer under the H1 (the query answered immediately). */
  lede: string;
  /** ISO date shown as "Actualizado el …" and in dateModified. */
  updated: string;
  appName: string;
  faq: FaqItem[];
  sourceParams: MxParamId[];
  extraSources?: ExtraSource[] | undefined;
  /** Date used to pick which parameter version to cite. */
  asOf: string;
  direction?: string | undefined;
  noindex?: boolean | undefined;
  pathOverride?: string | undefined;
  /** Hide the "Ejemplos" heading block when the page has none. */
  hasExamples?: boolean | undefined;
}

const p = Astro.props;
const path = p.pathOverride ?? pathFor(p.pageKey, p.locale);
const home = pathFor('home', p.locale);
const crumbs = [
  { name: 'Inicio', path: home },
  { name: p.h1, path },
];
const jsonLd = [
  webAppLd({ name: p.appName, description: p.description, path, inLanguage: 'es-MX', dateModified: p.updated, country: 'México' }),
  faqLd(p.faq),
  breadcrumbLd(crumbs),
];

const related: { key: PageKey; label: string; tool: Tool }[] = (
  [
    { key: 'mx.aguinaldo', label: 'Calculadora de aguinaldo', tool: 'aguinaldo' },
    { key: 'mx.finiquito', label: 'Calculadora de finiquito', tool: 'finiquito' },
    { key: 'mx.liquidacion', label: 'Calculadora de liquidación', tool: 'liquidacion' },
    { key: 'mx.prima-vacacional', label: 'Calculadora de prima vacacional', tool: 'prima-vacacional' },
    { key: 'mx.vacaciones', label: 'Calculadora de vacaciones', tool: 'vacaciones' },
    { key: 'mx.uma-salario-minimo', label: 'UMA y salario mínimo 2026', tool: 'uma' },
  ] as const
).filter((r) => r.key !== p.pageKey);
---

<BaseLayout
  title={p.title}
  description={p.description}
  locale={p.locale}
  pageKey={p.pageKey}
  path={path}
  ogSlug={p.tool}
  jsonLd={jsonLd}
  tool={p.tool}
  direction={p.direction}
  noindex={p.noindex}
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <ol>
        <li><a href={home}>Inicio</a></li>
        <li aria-current="page">{p.h1}</li>
      </ol>
    </nav>

    <header class="hero">
      <div class="hero__title-row">
        <StationIcon tool={p.tool} />
        <h1>{p.h1}</h1>
      </div>
      <p class="hero__lede">{p.lede}</p>
      <p class="hero__meta">
        <span>Actualizado el <time datetime={p.updated}>{formatDateLong(p.updated)}</time></span>
        <ReviewBadge pageKey={p.pageKey} />
      </p>
    </header>

    <slot />

    <section class="section" aria-labelledby="como-se-calcula">
      <h2 id="como-se-calcula">Cómo se calcula</h2>
      <div class="prose">
        <slot name="how" />
      </div>
    </section>

    {
      p.hasExamples !== false && (
        <section class="section" aria-labelledby="ejemplos">
          <h2 id="ejemplos">Ejemplos resueltos</h2>
          <slot name="examples" />
        </section>
      )
    }

    <slot name="extra" />

    <section class="section" aria-labelledby="preguntas">
      <h2 id="preguntas">Preguntas frecuentes</h2>
      <Faq items={p.faq} />
    </section>

    <section class="section" aria-labelledby="fuentes">
      <h2 id="fuentes">Fuentes y valores oficiales</h2>
      <Sources params={p.sourceParams} asOf={p.asOf} extra={p.extraSources} />
    </section>

    <section class="section" aria-labelledby="aviso">
      <div class="disclaimer">
        <h2 id="aviso">Aviso importante</h2>
        <p>
          Este cálculo es una estimación informativa con base en la Ley Federal del Trabajo, la Ley del ISR y los valores oficiales vigentes
          en la fecha indicada. No sustituye asesoría legal ni fiscal: tu contrato, un convenio o una resolución pueden darte más. La
          retención real de ISR depende de la nómina de tu empresa y se ajusta en tu declaración anual.
        </p>
        <p>
          Si tienes un conflicto laboral, la <a href="https://www.gob.mx/profedet" rel="noopener" target="_blank"
            >Procuraduría Federal de la Defensa del Trabajo (PROFEDET)</a
          > te asesora y representa gratis.
        </p>
        <p><ReviewBadge pageKey={p.pageKey} /></p>
      </div>
    </section>

    <section class="section" aria-labelledby="relacionadas">
      <h2 id="relacionadas">Otras calculadoras</h2>
      <ul class="related">
        {
          related.map((r) => (
            <li>
              <a href={pathFor(r.key, p.locale)} data-tool={r.tool}>
                <span class="dot" aria-hidden="true" />
                {r.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
