---
/**
 * Root: Cloudflare Pages redirects "/" to the default locale with a 302 (public/_redirects).
 * This page is the fallback for hosts without redirect rules: it lists every published locale.
 */
import { DEFAULT_LOCALE, publishedLocales, type LocaleCode } from '../i18n/locales';
import { pathFor } from '../i18n/routes';
const target = pathFor('home', DEFAULT_LOCALE);
const labels: Partial<Record<LocaleCode, string>> = {
  'es-mx': 'Calculadoras laborales de México',
  id: 'Weton dan kalender Jawa (Bahasa Indonesia)',
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tabula</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <ul>
      {
        publishedLocales().map((l) => (
          <li lang={l.htmlLang}>
            <a href={pathFor('home', l.code as LocaleCode)}>{labels[l.code as LocaleCode] ?? l.name}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
